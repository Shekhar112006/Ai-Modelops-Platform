import { useState } from 'react'
import './App.css'

const navigation = [
  { id: 'overview', label: 'Overview', icon: '◫', group: 'WORKSPACE' },
  { id: 'projects', label: 'Projects', icon: '▦', group: 'WORKSPACE' },
  { id: 'training', label: 'Training Jobs', icon: '⚙', group: 'WORKSPACE' },
  { id: 'registry', label: 'Model Registry', icon: '◈', group: 'WORKSPACE' },
  { id: 'deployments', label: 'Deployments', icon: '⇧', group: 'OPERATIONS' },
  { id: 'predictions', label: 'Predictions', icon: '⌁', group: 'OPERATIONS' },
  { id: 'observability', label: 'Observability', icon: '▥', group: 'OPERATIONS' },
] as const

type PageId = (typeof navigation)[number]['id']

const pageDetails: Record<PageId, { title: string; description: string }> = {
  overview: {
    title: 'Platform overview',
    description: 'Monitor your machine learning lifecycle from one workspace.',
  },
  projects: {
    title: 'Projects',
    description: 'Organize datasets, experiments, training jobs, and models.',
  },
  training: {
    title: 'Training jobs',
    description: 'Launch training workloads and follow their execution status.',
  },
  registry: {
    title: 'Model registry',
    description: 'Explore registered models, versions, and release readiness.',
  },
  deployments: {
    title: 'Deployments',
    description: 'Inspect staging and production deployment environments.',
  },
  predictions: {
    title: 'Prediction playground',
    description: 'Test model inference and inspect prediction responses.',
  },
  observability: {
    title: 'Observability',
    description: 'Monitor service health, request metrics, and platform errors.',
  },
}

const metrics = [
  { label: 'Total projects', icon: '▦', detail: 'Registered workspaces' },
  { label: 'Training jobs', icon: '⚙', detail: 'Across all projects' },
  { label: 'Registered models', icon: '◈', detail: 'Available model versions' },
  { label: 'Deployments', icon: '⇧', detail: 'Across environments' },
]

function App() {
  const [activePage, setActivePage] = useState<PageId>('overview')
  const [sidebarOpen, setSidebarOpen] = useState(false)
  const page = pageDetails[activePage]

  function selectPage(id: PageId) {
    setActivePage(id)
    setSidebarOpen(false)
  }

  return (
    <div className="app-shell">
      {sidebarOpen && (
        <button
          className="mobile-overlay"
          aria-label="Close navigation"
          onClick={() => setSidebarOpen(false)}
        />
      )}

      <aside className={`sidebar ${sidebarOpen ? 'sidebar-open' : ''}`}>
        <div className="brand">
          <div className="brand-mark">
            <span>◆</span>
          </div>
          <div className="brand-copy">
            <span className="brand-name">ModelOps</span>
            <span className="brand-subtitle">AI PLATFORM</span>
          </div>
          <span className="brand-version">v0.1.2</span>
        </div>

        <div className="workspace-switcher">
          <div className="workspace-avatar">M</div>
          <div className="workspace-copy">
            <span className="workspace-label">WORKSPACE</span>
            <span className="workspace-name">My workspace</span>
          </div>
          <span className="workspace-chevron">⌄</span>
        </div>

        <nav className="navigation" aria-label="Main navigation">
          {(['WORKSPACE', 'OPERATIONS'] as const).map((group) => (
            <div className="nav-group" key={group}>
              <p className="nav-heading">{group}</p>

              {navigation
                .filter((item) => item.group === group)
                .map((item) => (
                  <button
                    key={item.id}
                    className={`nav-item ${
                      activePage === item.id ? 'nav-item-active' : ''
                    }`}
                    onClick={() => selectPage(item.id)}
                    aria-current={activePage === item.id ? 'page' : undefined}
                  >
                    <span className="nav-icon">{item.icon}</span>
                    <span>{item.label}</span>
                    {item.id === 'training' && (
                      <span className="nav-count">—</span>
                    )}
                  </button>
                ))}
            </div>
          ))}
        </nav>

        <div className="sidebar-bottom">
          <div className="sidebar-status">
            <span className="status-dot status-dot-muted" />
            <div>
              <span className="sidebar-status-title">API connection</span>
              <span className="sidebar-status-subtitle">Not connected yet</span>
            </div>
          </div>

          <button
            className={`nav-item settings-item ${
              activePage === 'observability' ? 'settings-highlight' : ''
            }`}
            onClick={() => selectPage('observability')}
          >
            <span className="nav-icon">⚙</span>
            <span>Platform settings</span>
          </button>

          <div className="profile">
            <div className="profile-avatar">ML</div>
            <div className="profile-copy">
              <span className="profile-name">Platform workspace</span>
              <span className="profile-role">Local development</span>
            </div>
            <span className="profile-menu">···</span>
          </div>
        </div>
      </aside>

      <main className="main-panel">
        <header className="topbar">
          <div className="topbar-left">
            <button
              className="mobile-menu"
              aria-label="Open navigation"
              onClick={() => setSidebarOpen(true)}
            >
              ☰
            </button>

            <div className="breadcrumbs">
              <span>ModelOps</span>
              <span className="breadcrumb-divider">/</span>
              <span className="breadcrumb-current">{page.title}</span>
            </div>
          </div>

          <div className="topbar-right">
            <span className="environment-pill">
              <span className="status-dot status-dot-amber" />
              DEVELOPMENT
            </span>
            <button
              className="icon-button"
              aria-label="Notifications"
              title="Notifications"
            >
              ♧
            </button>
            <div className="topbar-avatar">ML</div>
          </div>
        </header>

        <div className="page-content">
          <section className="page-heading">
            <div>
              <div className="eyebrow">
                <span className="eyebrow-line" />
                MACHINE LEARNING OPERATIONS
              </div>
              <h1>{page.title}</h1>
              <p className="page-description">{page.description}</p>
            </div>

            <div className="heading-actions">
              <span className="connection-badge">
                <span className="status-dot status-dot-muted" />
                Awaiting API connection
              </span>
            </div>
          </section>

          {activePage === 'overview' ? (
            <>
              <section className="welcome-banner">
                <div className="welcome-content">
                  <div className="welcome-tag">
                    <span className="welcome-spark">✳</span>
                    YOUR ML WORKSPACE
                  </div>
                  <h2>From experiments to production.</h2>
                  <p>
                    Train, track, register, and deploy machine learning models
                    through one unified platform.
                  </p>
                  <button
                    className="primary-button"
                    onClick={() => selectPage('projects')}
                  >
                    Explore projects <span>→</span>
                  </button>
                </div>

                <div className="welcome-visual" aria-hidden="true">
                  <div className="visual-orbit orbit-one" />
                  <div className="visual-orbit orbit-two" />
                  <div className="visual-core">
                    <span>ML</span>
                  </div>
                  <div className="visual-node node-one">01</div>
                  <div className="visual-node node-two">02</div>
                  <div className="visual-node node-three">03</div>
                  <div className="visual-connector connector-one" />
                  <div className="visual-connector connector-two" />
                </div>
              </section>

              <section className="section-block">
                <div className="section-heading">
                  <div>
                    <h2>Platform metrics</h2>
                    <p>Live totals will appear when the API is connected.</p>
                  </div>
                  <span className="section-label">
                    <span className="status-dot status-dot-muted" />
                    NO DATA LOADED
                  </span>
                </div>

                <div className="metrics-grid">
                  {metrics.map((metric, index) => (
                    <article className="metric-card" key={metric.label}>
                      <div className="metric-card-top">
                        <div className={`metric-icon metric-icon-${index + 1}`}>
                          {metric.icon}
                        </div>
                        <span className="metric-more">···</span>
                      </div>
                      <p className="metric-label">{metric.label}</p>
                      <div className="metric-value">—</div>
                      <p className="metric-detail">{metric.detail}</p>
                      <div className="metric-footer">
                        <span className="metric-placeholder" />
                        <span>Waiting for backend</span>
                      </div>
                    </article>
                  ))}
                </div>
              </section>

              <section className="lower-grid">
                <article className="panel service-panel">
                  <div className="panel-heading">
                    <div>
                      <h2>Service health</h2>
                      <p>Connection status for platform components</p>
                    </div>
                    <span className="panel-menu">···</span>
                  </div>

                  <div className="service-list">
                    {[
                      ['Control plane API', 'FastAPI'],
                      ['Model router', 'Inference routing'],
                      ['Model server', 'Model inference'],
                      ['PostgreSQL', 'Metadata storage'],
                      ['Redis', 'Queue and cache'],
                      ['MLflow', 'Experiment tracking'],
                    ].map(([name, description]) => (
                      <div className="service-row" key={name}>
                        <div className="service-symbol">{name === 'PostgreSQL' ? '▤' : name === 'Redis' ? '◉' : name === 'MLflow' ? '⌁' : '◈'}</div>
                        <div className="service-copy">
                          <span className="service-name">{name}</span>
                          <span className="service-description">{description}</span>
                        </div>
                        <span className="service-unknown">
                          <span className="status-dot status-dot-muted" />
                          Not checked
                        </span>
                      </div>
                    ))}
                  </div>

                  <div className="panel-note">
                    Service status will be checked through health endpoints.
                  </div>
                </article>

                <article className="panel activity-panel">
                  <div className="panel-heading">
                    <div>
                      <h2>Recent activity</h2>
                      <p>Latest events across your workspace</p>
                    </div>
                    <span className="panel-menu">···</span>
                  </div>

                  <div className="empty-state">
                    <div className="empty-state-icon">◷</div>
                    <h3>No activity to show</h3>
                    <p>
                      Training jobs, model registrations, and deployment
                      events will appear here once connected.
                    </p>
                    <button
                      className="text-button"
                      onClick={() => selectPage('training')}
                    >
                      View training jobs <span>→</span>
                    </button>
                  </div>
                </article>
              </section>

              <footer className="page-footer">
                <span>
                  <span className="footer-indicator" />
                  AI ModelOps Platform
                </span>
                <span>Local development · Frontend preview</span>
              </footer>
            </>
          ) : (
            <section className="panel coming-soon-panel">
              <div className="coming-soon-icon">
                {navigation.find((item) => item.id === activePage)?.icon}
              </div>
              <span className="coming-soon-label">WORKSPACE MODULE</span>
              <h2>{page.title}</h2>
              <p>{page.description}</p>
              <div className="coming-soon-divider" />
              <div className="coming-soon-message">
                <span className="status-dot status-dot-amber" />
                This module is being prepared for integration with the existing
                FastAPI backend.
              </div>
              <button
                className="secondary-button"
                onClick={() => selectPage('overview')}
              >
                ← Back to overview
              </button>
            </section>
          )}
        </div>
      </main>
    </div>
  )
}

export default App
